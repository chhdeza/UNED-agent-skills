# Copy to .env and fill in your values for testing.
# Do not commit .env (it is in .gitignore).

MOODLE_URL=
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Optional: Web Services token for assignment grading (no HTML parsing).
# Create at: Site administration → Plugins → Web services → Manage tokens.
# Enable a service that includes "mod_assign" (e.g. Mobile app or custom).
MOODLE_TOKEN=

# ---- Notas Parciales (UNED) ----
# Para hablar con https://produccion.uned.ac.cr/notasparciales/ se necesitan
# DOS capas de autenticación apiladas:
#
#   1) NTLM (a nivel IIS): usuario UNED del SSO + password.
#   2) Cookies de sesión ASP.NET + WAF Imperva (3 cookies).
#
# Si falta cualquiera de las dos el server responde 401.

# 1) Credenciales NTLM. Es el usuario UNED del SSO (NO la cédula),
#    el mismo que usás en https://entornofuncionarios.uned.ac.cr/
#    Por ejemplo: usuario "jperez" (sin "@uned.ac.cr"), password del SSO.
NP_NTLM_USER=
NP_NTLM_PASSWORD=

# 2) Cookies de sesión. Obtenelas del navegador YA logueado en
#    https://produccion.uned.ac.cr/notasparciales/Formularios/CapturaNotas.aspx
#
# Cómo obtenerlas (Firefox):
#   1. Logueate normalmente en la página.
#   2. F12 → pestaña "Storage" → Cookies → https://produccion.uned.ac.cr
#   3. Copiá los 3 valores siguientes (click derecho → Copy).
#
# Las cookies expiran por inactividad (~20 min). Si el script empieza a
# fallar con 401, refrescá las 3 (recargando la página en Firefox y
# copiando otra vez).
NP_COOKIE_ASPNET_SESSIONID=
NP_COOKIE_UZMX=
NP_COOKIE_UZMXJ=

# (Reservado, no usado actualmente). Datos del usuario funcionario que
# aparecen en algunas llamadas como _peUsuarioCedula y _peUsuarioRole.
# Para roles típicos: 14 = TUTOR.
NP_USUARIO_CEDULA=
NP_USUARIO_ROLE=14